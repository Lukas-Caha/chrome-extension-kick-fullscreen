{
  "manifest_version": 3,
  "name": "Kick Extension",
  "version": "1.0",
  "description": "Custom modifications for Kick.com",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": [
        "src/utils/dom.js",
        "src/utils/observer.js",
        "src/utils/settings.js",
        "src/features/quickClipboard.js",
        "src/features/coopWindow.js",
        "src/features/layout.js",
        "src/features/transparency.js",
        "src/features/draggable.js",
        "src/features/resizable.js",
        "src/features/fullscreen.js",
        "src/features/chatSettingsInjector.js",
        "src/features/friendsHighlight.js",
        "src/features/mentionSound.js",
        "src/features/theme.js",
        "src/content/content.js"
      ],
      "css": [
        "src/styles/base.css",
        "src/styles/panels.css",
        "src/styles/chat.css",
        "src/styles/settings-panel.css",
        "src/styles/fullscreen.css",
        "src/styles/compat.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://kick.com/*"],
      "js": ["src/content/earlyTheme.js"],
      "css": ["src/styles/earlyTheme.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://kick.com/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/base.css",
        "src/styles/panels.css",
        "src/styles/chat.css",
        "src/styles/settings-panel.css",
        "src/styles/fullscreen.css",
        "src/styles/compat.css",
        "sounds/mention-ding.ogg",
        "images/kick-logo-silver.png",
        "images/kick-logo-burgundy.svg",
        "images/kick-logo-rainbow.svg"
      ],
      "matches": ["https://kick.com/*"]
    }
  ]
}
